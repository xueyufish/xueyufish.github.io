#!/usr/bin/env bash
# ==============================================================================
# upload-to-r2 — Upload images to Cloudflare R2 and copy public URL to clipboard
#
# Usage:
#   ./scripts/upload-to-r2 <file> [<file>...] [--dir <subdir>]
#   ./scripts/upload-to-r2 <dir>/*.png --dir <subdir>
#
# Examples:
#   ./scripts/upload-to-r2 screenshot.png --dir raft-protocol-intro
#   ./scripts/upload-to-r2 ~/Desktop/fig1.png --dir my-post-slug
#
# Output:
#   ✅ Uploaded: screenshot.png → attachment/raft-protocol-intro/screenshot.png
#   📋 Markdown: ![screenshot](/attachment/raft-protocol-intro/screenshot.png)
#   🔗  Public:  https://assets.yuxiumin.com/attachment/raft-protocol-intro/screenshot.png
# ==============================================================================
set -euo pipefail

# ── Config ──────────────────────────────────────────────────────────────────
BUCKET="blog-assets"
BASE_PATH="attachment"
CUSTOM_DOMAIN="https://assets.yuxiumin.com"

# Color output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ── Help ────────────────────────────────────────────────────────────────────
usage() {
  sed -n '3,16p' "$0"
  exit 0
}

# ── Parse args ──────────────────────────────────────────────────────────────
FILES=()
SUBDIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir|-d)
      SUBDIR="$2"
      shift 2
      ;;
    --help|-h)
      usage
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      ;;
    *)
      FILES+=("$1")
      shift
      ;;
  esac
done

if [[ ${#FILES[@]} -eq 0 ]]; then
  echo "Error: no files specified" >&2
  usage
fi

# ── Prompt for subdir if not provided ───────────────────────────────────────
if [[ -z "$SUBDIR" ]]; then
  # Try to guess from current dir name (useful if run from inside assets/attachment/)
  CURRENT_DIR="$(basename "$PWD")"
  read -r -p "Target subdirectory [${CURRENT_DIR}]: " input_subdir
  SUBDIR="${input_subdir:-$CURRENT_DIR}"
fi

# Normalize: trim trailing/leading slashes
SUBDIR="${SUBDIR#/}"
SUBDIR="${SUBDIR%/}"
SUBDIR="${SUBDIR// /-}"  # spaces → hyphens

# ── Check wrangler auth ─────────────────────────────────────────────────────
if ! wrangler whoami &>/dev/null; then
  echo -e "${YELLOW}⚠ wrangler not logged in. Run 'wrangler login' first.${NC}" >&2
  exit 1
fi

# ── Upload each file ────────────────────────────────────────────────────────
UPLOADED=()
for SRC in "${FILES[@]}"; do
  if [[ ! -f "$SRC" ]]; then
    echo -e "${YELLOW}⚠ Skipping (not a file): $SRC${NC}" >&2
    continue
  fi

  BASENAME="$(basename "$SRC")"
  # Strip spaces/特殊字符 to avoid URL encoding issues
  SAFE_NAME="${BASENAME// /-}"
  DEST_KEY="${BASE_PATH}/${SUBDIR}/${SAFE_NAME}"

  echo -e "${BLUE}↑ Uploading:${NC} $SRC"
  echo -e "     →  ${DEST_KEY}"

  if wrangler r2 object put "${BUCKET}/${DEST_KEY}" --file="$SRC" --remote &>/dev/null; then
    echo -e "${GREEN}✅ Uploaded:${NC} ${SAFE_NAME} → ${DEST_KEY}"

    # Build URLs
    PUBLIC_URL="${CUSTOM_DOMAIN}/${DEST_KEY}"
    MARKDOWN_REF="${DEST_KEY}"

    # Copy to clipboard (macOS)
    MARKDOWN_SYNTAX="![${BASENAME%%.*}](${PUBLIC_URL})"
    echo -n "$MARKDOWN_SYNTAX" | pbcopy 2>/dev/null || true

    echo -e "   ${GREEN}📋 Clipboard:${NC} ${MARKDOWN_SYNTAX}"
    echo -e "   ${GREEN}🔗  Public:${NC}    ${PUBLIC_URL}"
    echo ""
    UPLOADED+=("$DEST_KEY")
  else
    echo -e "${YELLOW}❌ Upload failed:${NC} $SRC" >&2
  fi
done

# Summary
COUNT=${#UPLOADED[@]}
if [[ $COUNT -gt 0 ]]; then
  echo -e "${GREEN}✓ Done. ${COUNT} file(s) uploaded.${NC}"
  echo ""
  echo "Markdown (all):"
  for KEY in "${UPLOADED[@]}"; do
    BASENAME="$(basename "$KEY")"
    echo "![${BASENAME%%.*}](${CUSTOM_DOMAIN}/${KEY})"
  done
fi
